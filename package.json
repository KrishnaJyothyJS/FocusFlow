{
  "name": "focusflow",
  "displayName": "FocusFlow",
  "description": "A cognitive accessibility engine for neurodivergent developers.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "focusflow.openDashboard",
        "title": "FocusFlow: Open Dashboard",
        "category": "FocusFlow"
      },
      {
        "command": "focusflow.resetWorkspace",
        "title": "FocusFlow: Reset Environment Defaults",
        "category": "FocusFlow"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  }
}